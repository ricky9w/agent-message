{
  "name": "agent-message-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit && bun run --cwd packages/relay check && biome check .",
    "format": "biome check --write .",
    "test": "bun test packages && bun run --cwd packages/relay test",
    "e2e": "bun test e2e",
    "build": "bun run --cwd packages/cli build",
    "dev": "bun packages/cli/src/main.ts"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
